{
  "info": {
    "name": "IPL Management System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "ownerId", "value": "" },
    { "key": "teamId", "value": "" },
    { "key": "playerId", "value": "" }
  ],
  "item": [
    {
      "name": "Create owner",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Owner\",\n  \"company\": \"Test Company\"\n}"
        },
        "url": "{{baseUrl}}/api/owners"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('created', () => pm.response.to.have.status(201));",
              "pm.test('success response', () => pm.expect(pm.response.json().status).to.eql('success'));",
              "pm.collectionVariables.set('ownerId', pm.response.json().data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create team",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Team\",\n  \"ownerId\": \"{{ownerId}}\"\n}"
        },
        "url": "{{baseUrl}}/api/teams"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('teamId', pm.response.json().data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create player",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Player\",\n  \"role\": \"Batsman\",\n  \"teamId\": \"{{teamId}}\"\n}"
        },
        "url": "{{baseUrl}}/api/players"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('playerId', pm.response.json().data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read all players",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/players" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('success', () => pm.response.to.have.status(200));",
              "pm.test('data is an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update player",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Player\",\n  \"role\": \"Bowler\",\n  \"teamId\": \"{{teamId}}\"\n}"
        },
        "url": "{{baseUrl}}/api/players/{{playerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('updated', () => pm.response.to.have.status(200));",
              "pm.test('name changed', () => pm.expect(pm.response.json().data.name).to.eql('Updated Player'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete player",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/players/{{playerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('deleted', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete team",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/teams/{{teamId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('deleted', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete owner",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/owners/{{ownerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('deleted', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
